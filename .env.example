# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# AI (OpenRouter, Google Gemini models only)
OPENROUTER_API_KEY=your-openrouter-key

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Needed by the Stripe webhook. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (use test mode keys until you go live)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PRO_PRICE_LABEL=₹299 / month
