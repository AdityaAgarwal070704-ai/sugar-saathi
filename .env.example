# Copy this file to .env.local and fill in your own values. Never commit .env.local.

# AI (OpenRouter, Google Gemini models only)
OPENROUTER_API_KEY=your-openrouter-key

# Login with Google. Leave these three out and the app stays open to everyone (no login).
#   1. console.cloud.google.com -> APIs & Services -> Credentials -> Create OAuth client ID (Web application)
#   2. Authorised redirect URIs: https://YOUR-SITE/api/auth/callback  and  http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# A long random string that signs login cookies, for example: openssl rand -base64 32
AUTH_SECRET=generate-a-long-random-string

# Optional
# Emails (comma separated) that always get Pro, for testers and friends
PRO_EMAILS=
# A form link (for example a Google Form) where people can ask to be told when Pro launches
NEXT_PUBLIC_WAITLIST_URL=
# Shown on the Privacy and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=
# Only if the site is served from a different address than Google should redirect to
AUTH_URL=
# Development only (ignored in production builds): fake login to test Free, trial and Pro without Google
# AUTH_MOCK=1
